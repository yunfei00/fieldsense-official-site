# Django（生产环境请替换为强随机密钥）
DJANGO_SECRET_KEY=change-me-in-production

# true / false
DJANGO_DEBUG=true

# 逗号分隔，无空格；Docker 内需包含 backend 服务名
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# CORS 允许的前端来源，逗号分隔
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# CSRF 信任的源（通常与前端访问地址一致），逗号分隔
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SQLite 数据库文件（用于 Docker 持久化）
SQLITE_DB_PATH=/app/data/db.sqlite3

# 线索通知通道，可多选：feishu,console
LEAD_NOTIFY_CHANNELS=console

# 飞书机器人配置（留空表示不启用飞书发送）
FEISHU_WEBHOOK_URL=
FEISHU_KEYWORD=FieldSense
FEISHU_TIMEOUT_SECONDS=5
